{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "open-loops",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	"r2_buckets": [{ "binding": "OPENLoops_ASSETS", "bucket_name": "open-loops-media" }],

	"vars": {
		"PUBLIC_SITE_URL": "",
		"PUBLIC_UMAMI_SHARE_URL": "https://cloud.umami.is/share/Lq6huFN0xlcHd8oG",
		"PUBLIC_R2_PUBLIC_URL": "https://assets.indexdaily.in"
	}
}
