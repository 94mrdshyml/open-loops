# Open Tabs — Environment Variables
# Copy this file to .env and fill in all values.
# Never commit .env to version control.

# NeonDB connection string (use the pooled connection URL from Neon dashboard)
DATABASE_URL=

# Better Auth secret key — minimum 32 random characters
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Resend API key — from resend.com dashboard
RESEND_API_KEY=

# Sender address for all outgoing emails — must be from a verified Resend domain
# Dev: use onboarding@resend.dev (Resend's shared test domain, no verification needed)
# Prod: use noreply@yourdomain.com after verifying the domain in Resend dashboard
RESEND_FROM_EMAIL=
# Display name for the sender, e.g. "Open Tabs"
RESEND_FROM_NAME=

# Cloudflare R2 — bucket name (not the URL, just the name)
R2_BUCKET=

# Cloudflare account ID — from Cloudflare dashboard right sidebar
R2_ACCOUNT_ID=

# R2 API token credentials — create via Cloudflare dashboard → R2 → Manage API tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Umami Cloud website ID — from umami.is dashboard → website settings
UMAMI_WEBSITE_ID=

# Umami share dashboard URL — from umami.is → website → Share URL (public, no auth required)
PUBLIC_UMAMI_SHARE_URL=

# Canonical public URL of the site — no trailing slash
# Dev: http://localhost:5173 | Prod: https://opentabs.indexdaily.in
PUBLIC_SITE_URL=

ORIGIN=""

# Cron secret — random token to protect /api/cron/publish from unauthorized calls
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend newsletter — segment and topic IDs from Resend dashboard
RESEND_SEGMENT_ALL_USERS_ID=
RESEND_SEGMENT_NEWSLETTER_ID=
RESEND_TOPIC_NEWSLETTER_ID=

# Resend webhook signing secret — from Resend dashboard → Webhooks
RESEND_WEBHOOK_SECRET=
