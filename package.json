{
	"name": "open-tabs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:seed": "node --env-file=.env --import=tsx/esm src/lib/server/db/seed.ts",
		"email:preview": "email dev --dir src/lib/email"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@neondatabase/serverless": "^1.0.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@types/react": "^19.2.15",
		"better-auth": "~1.4.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.6",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-bubble-menu": "^3.31.4",
		"@tiptap/extension-character-count": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-link": "3.31.4",
		"@tiptap/extension-placeholder": "^3.31.4",
		"@tiptap/extension-typography": "^3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"clsx": "^2.1.1",
		"nanoid": "^5.1.16",
		"react": "^19.2.6",
		"resend": "^6.12.3",
		"tailwind-merge": "^3.6.0",
		"unique-username-generator": "^1.5.1",
		"zod": "^4.4.3"
	}
}
